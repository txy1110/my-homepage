        }
      ]
    },
    {
      "name": "错误响应格式",
      "request": { "method": "GET", "url": "{{baseUrl}}/projects/not-a-real-project-id" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Not found uses standard error envelope', function () {",
            "  pm.response.to.have.status(404);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(false);",
            "  pm.expect(body.error.code).to.eql('RESOURCE_NOT_FOUND');",
            "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
            "});"
          ]
        }
      }]
    },
    {
      "name": "查询参数校验错误",
      "request": { "method": "GET", "url": "{{baseUrl}}/skills?profileId=not-a-number" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Invalid query parameter returns standard 400 error', function () {",
            "  pm.response.to.have.status(400);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(false);",
            "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
            "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
            "});"
          ]
        }
      }]
    },
    {
      "name": "未登录导出应被拒绝",
      "request": { "method": "GET", "url": "{{baseUrl}}/export" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Export requires an authenticated admin session', function () {",
            "  pm.response.to.have.status(401);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(false);",
            "  pm.expect(body.error.code).to.eql('UNAUTHORIZED');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "退出管理员会话",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Admin session is revoked', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.success).to.eql(true);",
            "  pm.environment.unset('adminToken');",
            "});"
          ]
        }
      }]
    }
  ]
}
